{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/macel94/belacca-status/main/status.schema.json",
  "title": "Belacca automated public status contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sanitized",
    "publication_state",
    "status",
    "summary",
    "observation_id",
    "observed_at",
    "updated_at",
    "evidence_timestamp",
    "valid_until",
    "publisher",
    "monitoring_policy",
    "components",
    "incidents",
    "source_references",
    "notes"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schema_version": { "const": "belacca.public-status.v2" },
    "sanitized": { "const": true },
    "publication_state": { "enum": ["not_configured", "published"] },
    "status": { "enum": ["operational", "degraded", "incident", "unknown"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "observation_id": { "type": ["string", "null"], "maxLength": 120 },
    "observed_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "evidence_timestamp": { "type": ["string", "null"], "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_reference"],
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 120 },
        "source_reference": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "monitoring_policy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "approved_by", "approved_at", "runner", "interval", "freshness_ttl", "failure_threshold", "recovery_threshold"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "approved_by": { "type": "string", "minLength": 1, "maxLength": 120 },
        "approved_at": { "type": "string", "format": "date-time" },
        "runner": { "type": "string", "minLength": 1, "maxLength": 120 },
        "interval": { "type": "string", "minLength": 1, "maxLength": 40 },
        "freshness_ttl": { "type": "string", "minLength": 1, "maxLength": 40 },
        "failure_threshold": { "type": "integer", "minimum": 1, "maximum": 10 },
        "recovery_threshold": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "components": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "critical", "status", "summary", "evidence_timestamp", "source_references"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "critical": { "type": "boolean" },
          "status": { "enum": ["operational", "degraded", "incident", "unknown"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
          "evidence_timestamp": { "type": "string", "format": "date-time" },
          "duration_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
          "source_references": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
        }
      }
    },
    "incidents": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary", "started_at", "updated_at", "source_references"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "status": { "enum": ["investigating", "identified", "monitoring", "resolved"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
          "started_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "source_references": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
        }
      }
    },
    "source_references": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "notes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } }
  }
}
